        "body": {
          "data": "{\n  \"aggregate\": \"question\",\n  \"pipeline\": [\n    {\n      \"$lookup\": {\n        \"from\": \"appsmith_test\",\n        \"let\": { \"qIdString\": { \"$toString\": \"$_id\" } },\n        \"pipeline\": [\n          { \"$unwind\": \"$questions\" },\n          {\n            \"$match\": {\n              \"$expr\": {\n                \"$and\": [\n                  { \"$eq\": [\"$questions._id\", \"$$qIdString\"] },\n                  {\n                    \"$or\": [\n                      { \"$eq\": [\"$questions.isCorrect\", false] },\n                      { \"$eq\": [{ \"$type\": \"$questions.isCorrect\" }, \"missing\"] }\n                    ]\n                  }\n                ]\n              }\n            }\n          }\n        ],\n        \"as\": \"failures\"\n      }\n    },\n    {\n      \"$addFields\": {\n        \"failureCount\": { \"$size\": \"$failures\" }\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"answer\",\n        \"localField\": \"_id\",\n        \"foreignField\": \"question_id\",\n        \"as\": \"answers\"\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"bookmark\",\n        \"let\": { \"qId\": { \"$toString\": \"$_id\" } },\n        \"pipeline\": [\n          {\n            \"$match\": {\n              \"$expr\": { \"$eq\": [\"$questionId\", \"$$qId\"] }\n            }\n          }\n        ],\n        \"as\": \"bookmarkMatch\"\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"tags\",\n        \"let\": { \"qId\": { \"$toString\": \"$_id\" } },\n        \"pipeline\": [\n          {\n            \"$match\": {\n              \"$expr\": { \"$eq\": [\"$questionId\", \"$$qId\"] }\n            }\n          }\n        ],\n        \"as\": \"tagMatch\"\n      }\n    },\n    {\n      \"$sort\": {\n        \"failureCount\": -1\n      }\n    },\n    {\n      \"$project\": {\n        \"_id\": { \"$toString\": \"$_id\" },\n        \"failureCount\": 1,\n        \"question\": \"$question\",\n        \"domain\": \"$domain\",\n        \"correctAnswer\": \"$correct\",\n        \"answers\": 1,\n        \"isBookmarked\": {\n          \"$gt\": [{ \"$size\": \"$bookmarkMatch\" }, 0]\n        },\n        \"tags\": {\n          \"$ifNull\": [\n            { \"$arrayElemAt\": [\"$tagMatch\", 0] },\n            null\n          ]\n        }\n      }\n    }\n  ],\n  \"cursor\": {}\n}"
