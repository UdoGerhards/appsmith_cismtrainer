        "body": {
          "data": "{\n  \"aggregate\": \"question\",\n  \"pipeline\": [\n    {\n      \"$match\": {\n        \"domain\": \"{{ this.params.domain || '' }}\"\n      }\n    },\n    {\n      \"$lookup\": {\n        \"from\": \"appsmith_test\",\n        \"let\": { \"qIdStr\": { \"$toString\": \"$_id\" } },\n        \"pipeline\": [\n          { \"$unwind\": \"$questions\" },\n          {\n            \"$match\": {\n              \"$expr\": { \"$eq\": [\"$questions._id\", \"$$qIdStr\"] }\n            }\n          },\n          { \"$count\": \"occurrenceCount\" }\n        ],\n        \"as\": \"testCountData\"\n      }\n    },\n    {\n      \"$addFields\": {\n        \"usageCount\": {\n          \"$ifNull\": [{ \"$arrayElemAt\": [\"$testCountData.occurrenceCount\", 0] }, 0]\n        }\n      }\n    },\n    {\n      \"$group\": {\n        \"_id\": \"$usageCount\",\n        \"count\": { \"$sum\": 1 }\n      }\n    },\n    {\n      \"$group\": {\n        \"_id\": null,\n        \"maxUsage\": { \"$max\": \"$_id\" },\n        \"items\": { \"$push\": { \"usage\": \"$_id\", \"count\": \"$count\" } }\n      }\n    },\n    {\n      \"$project\": {\n        \"_id\": 0,\n        \"result\": {\n          \"$map\": {\n            \"input\": { \"$range\": [0, { \"$add\": [\"$maxUsage\", 1] }] },\n            \"as\": \"i\",\n            \"in\": {\n              \"$let\": {\n                \"vars\": {\n                  \"found\": {\n                    \"$arrayElemAt\": [\n                      {\n                        \"$filter\": {\n                          \"input\": \"$items\",\n                          \"as\": \"item\",\n                          \"cond\": { \"$eq\": [\"$$item.usage\", \"$$i\"] }\n                        }\n                      },\n                      0\n                    ]\n                  }\n                },\n                \"in\": {\n                  \"$ifNull\": [\"$$found.count\", 0]\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  ],\n  \"cursor\": {}\n}"
