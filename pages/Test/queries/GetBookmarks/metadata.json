          "data": "{\n  \"aggregate\": \"bookmark\",\n  \"pipeline\": {{\n    (() => {\n      // Übergebene IDs (können ObjectIds oder Strings sein)\n      const inputIds = this.params.ids || [];\n\n      // Alle IDs sicher in Strings umwandeln für den Abgleich mit \"questionId\"\n      const stringIds = inputIds.map(id => id.toString());\n\n      let pipeline = [];\n\n      if (stringIds.length > 0) {\n        pipeline.push({\n          \"$match\": {\n            \"questionId\": {\n              \"$in\": stringIds\n            }\n          }\n        });\n      } else {\n        // Falls keine IDs übergeben wurden, gib standardmäßig nichts zurück (Sicherheitsschutz)\n        pipeline.push({\n          \"$match\": {\n            \"questionId\": { \"$in\": [] }\n          }\n        });\n      }\n\n      return pipeline;\n    })()\n  }},\n  \"cursor\": {}\n}"
