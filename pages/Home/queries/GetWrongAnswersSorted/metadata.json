"$project\": {\n        \"_id\": { \"$toString\": \"$_id\" },\n        \"failureCount\": 1,\n        \"question\": \"$questionDetails.question\",\n        \"domain\": \"$questionDetails.domain\",\n        \"correctAnswer\": \"$questionDetails.correct\",\n        \"answers\": 1,\n        \"isBookmarked\": {\n          \"$gt\": [{ \"$size\": \"$bookmarkMatch\" }, 0]\n        },\n        \"tags\": {\n          \"$ifNull\": [\n            { \"$arrayElemAt\": [\"$tagMatch\", 0] },\n            null\n          ]\n        }\n      }\n    }\n  ],\n  \"cursor\": {}\n}"
